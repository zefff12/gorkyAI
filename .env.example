# Необязательно: без ключа работает встроенный rule-based парсер
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Семантический поиск на эмбеддингах (модель ~240 МБ скачивается при первом запуске). 0 — выключить
SEMANTIC_SEARCH=1
MODEL_CACHE=data/models
# Часовой пояс пользователя
APP_TZ=Europe/Moscow
# Где хранить базу (по умолчанию data/assistant.db)
DB_PATH=data/assistant.db
# Для демо можно «заморозить» текущее время
# FAKE_NOW=2026-10-15T09:00
